        }

        function renderShopQuestion() {
            const qObj = activeShop.questions[activeShopQIdx];
            document.getElementById('shopModalBadge').textContent = `${activeShop.icon} ${activeShop.name}`;
            document.getElementById('shopModalTitle').textContent = `Tantangan di ${activeShop.name}`;
            document.getElementById('shopModalStep').textContent = `Tantangan ${activeShopQIdx + 1} dari ${activeShop.questions.length}`;
            document.getElementById('shopQuestionText').textContent = qObj.q;

            const fb = document.getElementById('shopFeedback');
            fb.className = 'feedback-banner';
            fb.style.display = 'none';
            document.getElementById('shopNextBtn').style.display = 'none';

            const grid = document.getElementById('shopOptionsGrid');
            grid.innerHTML = '';
            qObj.opts.forEach((opt, idx) => {
                const btn = document.createElement('button');
                btn.className = 'option-btn';
                btn.textContent = opt;
                btn.onclick = () => {
                    if (idx === qObj.ans) {
                        btn.classList.add('correct');
                        grid.querySelectorAll('button').forEach(b => b.disabled = true);
                        fb.className = 'feedback-banner success';
                        fb.innerHTML = `🌟 <strong>HOREEEEE! KAMU HEBAT!</strong><br>${qObj.exp}`;
                        fb.style.display = 'block';
                        document.getElementById('shopNextBtn').style.display = 'inline-flex';
                        AudioEngine.playCorrectFeedback();
                        triggerStarBurst();
                    } else {
                        btn.classList.add('wrong');
                        setTimeout(() => btn.classList.remove('wrong'), 450);
                        fb.className = 'feedback-banner retry';
                        fb.innerHTML = `💪 <strong>COBAAA LAGI! KAMU PASTI BISA!</strong>`;
                        fb.style.display = 'block';
                        AudioEngine.playWrongFeedback();
                    }
                };
                grid.appendChild(btn);
            });
        }

        function nextShopQuestion() {
            AudioEngine.playClick();
            if (activeShopQIdx < activeShop.questions.length - 1) {
                activeShopQIdx++;
                renderShopQuestion();
            } else {
                const wasNew = !GameState.mallCompletedShops.has(activeShop.id);
                GameState.mallCompletedShops.add(activeShop.id);
                if (wasNew) {
                    addRewards(3, 25);
                }
                renderMallShopChips();
                closeModal('shopModal');

                if (GameState.mallCompletedShops.size === mallShops.length) {
                    AudioEngine.playApplauseAndWin();
