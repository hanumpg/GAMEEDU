        function renderMallShopChips() {
            const container = document.getElementById('mallShopStatusList');
            container.innerHTML = '';
            mallShops.forEach(s => {
                const done = GameState.mallCompletedShops.has(s.id);
                const chip = document.createElement('span');
                chip.className = 'shop-chip' + (done ? ' done' : '');
                chip.textContent = `${s.icon} ${s.name} ${done ? '✅' : ''}`;
                container.appendChild(chip);
            });
