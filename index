    <script>
        /* ==========================================================================
           A. SISTEM AUDIO OFFLINE (WEB AUDIO API + SPEECH SYNTHESIS API)
           ========================================================================== */
        const AudioEngine = {
            ctx: null,
            musicEnabled: true,
            sfxEnabled: true,
            volume: 0.8,
            bgmInterval: null,
            bgmStep: 0,
            unlocked: false,

            init() {
                if (!this.ctx) {
                    const AudioCtx = window.AudioContext || window.webkitAudioContext;
                    if (AudioCtx) {
                        this.ctx = new AudioCtx();
                    }
                }
                if (this.ctx && this.ctx.state === 'suspended') {
                    this.ctx.resume();
                }
                if (!this.unlocked) {
                    this.unlocked = true;
                    if (this.musicEnabled) this.startBgm();
                }
            },

            playTone(freq, duration, type = 'sine', volScale = 0.25, delay = 0) {
                if (!this.sfxEnabled || !this.ctx || this.volume <= 0) return;
                const now = this.ctx.currentTime + delay;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = type;
                osc.frequency.setValueAtTime(freq, now);
                gain.gain.setValueAtTime(this.volume * volScale, now);
                gain.gain.exponentialRampToValueAtTime(0.001, now + duration);
                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start(now);
                osc.stop(now + duration);
            },

            playClick() {
                this.init();
                this.playTone(620, 0.08, 'triangle', 0.22);
            },

            playCoin() {
                this.init();
                this.playTone(987.77, 0.1, 'sine', 0.25, 0);
                this.playTone(1318.51, 0.25, 'sine', 0.25, 0.09);
            },

            playApplauseAndWin() {
                this.init();
                // Melodi fanfare ceria
                const notes = [523.25, 659.25, 783.99, 1046.50, 783.99, 1046.50];
                const times = [0, 0.12, 0.24, 0.36, 0.52, 0.66];
                notes.forEach((n, i) => this.playTone(n, 0.22, 'triangle', 0.3, times[i]));

                // Simulasi tepuk tangan (noise burst ritmis)
                if (this.sfxEnabled && this.ctx) {
                    for (let c = 0; c < 6; c++) {
                        this.playClap(0.15 + c * 0.14);
                    }
                }
            },

            playClap(delay) {
                if (!this.ctx || !this.sfxEnabled) return;
                const bufferSize = this.ctx.sampleRate * 0.08;
                const buffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
                const data = buffer.getChannelData(0);
                for (let i = 0; i < bufferSize; i++) {
                    data[i] = (Math.random() * 2 - 1) * Math.exp(-i / (bufferSize * 0.3));
                }
                const noise = this.ctx.createBufferSource();
                noise.buffer = buffer;
                const filter = this.ctx.createBiquadFilter();
                filter.type = 'bandpass';
                filter.frequency.value = 1200;
                const gain = this.ctx.createGain();
                gain.gain.value = this.volume * 0.25;
                noise.connect(filter);
                filter.connect(gain);
                gain.connect(this.ctx.destination);
                noise.start(this.ctx.currentTime + delay);
            },

            speakChild(text, isHappy = true) {
                this.init();
                if (!this.sfxEnabled) return;
                if ('speechSynthesis' in window) {
                    window.speechSynthesis.cancel();
                    const utter = new SpeechSynthesisUtterance(text);
                    utter.lang = 'id-ID';
                    utter.pitch = isHappy ? 1.55 : 1.35; // Nada tinggi ceria seperti anak-anak
                    utter.rate = isHappy ? 1.05 : 0.98;
                    utter.volume = this.volume;
                    window.speechSynthesis.speak(utter);
                }
            },

            playCorrectFeedback() {
                this.init();
                // Melodi naik ceria + ucapan anak-anak
                this.playTone(523.25, 0.12, 'triangle', 0.28, 0);
                this.playTone(659.25, 0.12, 'triangle', 0.28, 0.1);
                this.playTone(783.99, 0.25, 'triangle', 0.3, 0.2);
                this.speakChild("HOREEEEE! KAMU HEBAT!", true);
            },

            playWrongFeedback() {
                this.init();
                // Nada lembut penyemangat + ucapan anak-anak
                this.playTone(392.00, 0.15, 'sine', 0.22, 0);
                this.playTone(329.63, 0.22, 'sine', 0.22, 0.14);
                this.speakChild("COBAAA LAGI! KAMU PASTI BISA!", false);
            },

            startBgm() {
                if (this.bgmInterval) clearInterval(this.bgmInterval);
                // Melodi anak-anak ceria (C Mayor Pentatonik)
                const melody = [
                    523.25, 659.25, 783.99, 659.25,
                    587.33, 698.46, 880.00, 698.46,
                    523.25, 659.25, 783.99, 1046.50,
                    880.00, 783.99, 659.25, 587.33
                ];
                this.bgmInterval = setInterval(() => {
                    if (!this.musicEnabled || !this.ctx || this.ctx.state !== 'running') return;
                    const freq = melody[this.bgmStep % melody.length];
                    this.playTone(freq, 0.24, 'sine', 0.06, 0);
                    this.bgmStep++;
                }, 420);
            },

            stopBgm() {
                if (this.bgmInterval) {
                    clearInterval(this.bgmInterval);
                    this.bgmInterval = null;
                }
            }
        };

        /* ==========================================================================
           B. STATE GLOBAL PERMAINAN & PROGRES
           ========================================================================== */
        const GameState = {
            playerName: "Detektif Cilik",
            stars: 0,
            coins: 0,
            detectiveSolved: new Set(),
            mallCompletedShops: new Set(),
            puzzleCompletedWords: new Set()
        };

        function addRewards(starsToAdd, coinsToAdd = 0) {
            GameState.stars += starsToAdd;
            GameState.coins += coinsToAdd;
            if (coinsToAdd > 0) AudioEngine.playCoin();
            updateAllHUD();
        }

        function updateAllHUD() {
            document.getElementById('hudStars').textContent = GameState.stars;
            document.getElementById('hudCoins').textContent = GameState.coins;
            document.getElementById('menuProgDetective').textContent = `Progres: ${GameState.detectiveSolved.size} / 15 Soal`;
            document.getElementById('menuProgMall').textContent = `Toko Selesai: ${GameState.mallCompletedShops.size} / 6 Toko`;
            document.getElementById('menuProgPuzzle').textContent = `Puzzle Selesai: ${GameState.puzzleCompletedWords.size} / 10 Kata`;

            // Update Profil & Hasil
            document.getElementById('profStars').textContent = GameState.stars;
            document.getElementById('profCoins').textContent = GameState.coins;
            document.getElementById('resTotalStars').textContent = GameState.stars;
            document.getElementById('resTotalCoins').textContent = GameState.coins;
            document.getElementById('resDetectiveDetail').textContent = `${GameState.detectiveSolved.size} / 15 Soal Selesai`;
            document.getElementById('resMallDetail').textContent = `${GameState.mallCompletedShops.size} / 6 Toko Dikunjungi`;
            document.getElementById('resPuzzleDetail').textContent = `${GameState.puzzleCompletedWords.size} / 10 Puzzle Selesai`;

            const isAllFinished =
                GameState.detectiveSolved.size >= 15 &&
                GameState.mallCompletedShops.size >= 6 &&
                GameState.puzzleCompletedWords.size >= 10;

            const rankEl = document.getElementById('detectiveRankTitle');
            const profRankEl = document.getElementById('profRank');
            const headlineEl = document.getElementById('resultHeadline');
            const subEl = document.getElementById('resultSubtitle');

            if (isAllFinished) {
                rankEl.textContent = "DETEKTIF FONOLOGI HEBAT!";
                profRankEl.textContent = "DETEKTIF FONOLOGI HEBAT!";
                headlineEl.textContent = `SELAMAT, ${GameState.playerName.toUpperCase()}!`;
                subEl.textContent = "Kamu telah berhasil menjelajahi dunia fonologi, memecahkan teka-teki bunyi, menjelajahi mall, dan menyelesaikan puzzle kata.";
            } else if (GameState.stars >= 15) {
                rankEl.textContent = "DETEKTIF BUNYI JUNIOR";
                profRankEl.textContent = "DETEKTIF BUNYI JUNIOR";
            } else {
                rankEl.textContent = "DETEKTIF FONOLOGI PEMULA";
                profRankEl.textContent = "DETEKTIF FONOLOGI PEMULA";
            }
        }

        /* ==========================================================================
           C. NAVIGASI HALAMAN, MODAL, DAN EFEK VISUAL
           ========================================================================== */
        function navigateTo(screenId) {
            AudioEngine.playClick();
            document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
            const target = document.getElementById(`screen-${screenId}`);
            if (target) target.classList.add('active');

            document.querySelectorAll('.nav-btn[data-nav]').forEach(btn => {
                btn.classList.toggle('active', btn.dataset.nav === screenId);
            });

            if (screenId === 'mall') {
                resizeMallCanvas();
                renderMallShopChips();
            }
            if (screenId === 'result') {
                updateAllHUD();
                if (GameState.detectiveSolved.size >= 15 && GameState.mallCompletedShops.size >= 6 && GameState.puzzleCompletedWords.size >= 10) {
                    launchConfetti(60);
                    AudioEngine.playApplauseAndWin();
                }
            }
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function startAdventure() {
            AudioEngine.init();
            AudioEngine.playClick();
            navigateTo('menu');
        }

        function openModal(id) {
            AudioEngine.playClick();
            updateAllHUD();
            document.getElementById(id).classList.add('open');
        }

        function closeModal(id) {
            AudioEngine.playClick();
            document.getElementById(id).classList.remove('open');
        }

        function saveProfileName() {
            const val = document.getElementById('playerNameInput').value.trim();
            if (val) GameState.playerName = val;
            updateAllHUD();
            closeModal('profileModal');
        }

        function toggleMusicSetting() {
            AudioEngine.init();
            AudioEngine.musicEnabled = !AudioEngine.musicEnabled;
            const btn = document.getElementById('toggleMusicBtn');
            btn.textContent = AudioEngine.musicEnabled ? 'ON' : 'OFF';
            btn.className = AudioEngine.musicEnabled ? 'btn-kid btn-green' : 'btn-kid btn-orange';
            if (AudioEngine.musicEnabled) AudioEngine.startBgm();
            else AudioEngine.stopBgm();
        }

        function toggleSfxSetting() {
            AudioEngine.init();
            AudioEngine.sfxEnabled = !AudioEngine.sfxEnabled;
            const btn = document.getElementById('toggleSfxBtn');
            btn.textContent = AudioEngine.sfxEnabled ? 'ON' : 'OFF';
            btn.className = AudioEngine.sfxEnabled ? 'btn-kid btn-blue' : 'btn-kid btn-orange';
        }

        function updateVolume(val) {
            AudioEngine.volume = val / 100;
            document.getElementById('volumeLabel').textContent = `${val}%`;
        }

        function testCheerVoice() {
            AudioEngine.playCorrectFeedback();
            triggerStarBurst();
        }

        function triggerStarBurst() {
            const el = document.createElement('div');
            el.className = 'star-burst';
            el.textContent = '⭐✨🌟';
            document.getElementById('fxLayer').appendChild(el);
            setTimeout(() => el.remove(), 950);
