                tile.className = 'letter-tile';
                tile.textContent = q.scrambled[poolIdx];
                tile.title = 'Klik untuk mengembalikan huruf';
                tile.onclick = () => {
                    AudioEngine.playClick();
                    scrambleSelectedIndices.splice(slotPos, 1);
