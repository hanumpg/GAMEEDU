        function checkMallCollision(nx, ny) {
            const r = playerMall.radius;
            // Batas dinding luar mall
            if (nx - r < 18 || nx + r > 842 || ny - r < 18 || ny + r > 522) return true;

            // Tabrakan dengan bangunan toko
            for (const s of mallShops) {
                if (nx + r > s.x && nx - r < s.x + s.w && ny + r > s.y && ny - r < s.y + s.h) {
                    return true;
                }
            }

            // Tabrakan dengan air mancur / bangku
            for (const obs of mallObstacles) {
                if (nx + r > obs.x && nx - r < obs.x + obs.w && ny + r > obs.y && ny - r < obs.y + obs.h) {
                    return true;
                }
            }
            return false;
        }

        function updateMallSimulation() {
            if (!document.getElementById('screen-mall').classList.contains('active')) return;
            if (document.getElementById('shopModal').classList.contains('open')) return;

            let dx = 0, dy = 0;
            if (keysPressed.ArrowUp) { dy -= 1; playerMall.dir = 'up'; }
            if (keysPressed.ArrowDown) { dy += 1; playerMall.dir = 'down'; }
            if (keysPressed.ArrowLeft) { dx -= 1; playerMall.dir = 'left'; }
            if (keysPressed.ArrowRight) { dx += 1; playerMall.dir = 'right'; }

            if (dx !== 0 || dy !== 0) {
                const len = Math.hypot(dx, dy);
                dx = (dx / len) * playerMall.speed;
                dy = (dy / len) * playerMall.speed;

                if (!checkMallCollision(playerMall.x + dx, playerMall.y)) playerMall.x += dx;
                if (!checkMallCollision(playerMall.x, playerMall.y + dy)) playerMall.y += dy;

                playerMall.moving = true;
                playerMall.walkFrame += 0.22;
            } else {
                playerMall.moving = false;
                playerMall.walkFrame = 0;
            }

            // Cek kedekatan dengan pintu toko
            nearbyShop = null;
            for (const s of mallShops) {
                const dist = Math.hypot(playerMall.x - s.doorX, playerMall.y - s.doorY);
                if (dist < 46) {
                    nearbyShop = s;
                    break;
                }
            }

            const overlay = document.getElementById('mallInteractOverlay');
            const btn = document.getElementById('mallInteractBtn');
            if (nearbyShop) {
                overlay.style.display = 'block';
                const isDone = GameState.mallCompletedShops.has(nearbyShop.id);
                btn.textContent = `${nearbyShop.icon} ${isDone ? 'ULANGI' : 'KUNJUNGI'} ${nearbyShop.name}`;
            } else {
                overlay.style.display = 'none';
            }
        }

        function drawMallWorld() {
            const canvas = document.getElementById('mallCanvas');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');

            // 1. Lantai Keramik Pastel Mall
            ctx.fillStyle = '#FFFDE7';
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            // Pola ubin lantai
            ctx.strokeStyle = '#F0E68C';
            ctx.lineWidth = 1;
            for (let gx = 0; gx < canvas.width; gx += 40) {
                ctx.beginPath(); ctx.moveTo(gx, 0); ctx.lineTo(gx, canvas.height); ctx.stroke();
            }
            for (let gy = 0; gy < canvas.height; gy += 40) {
                ctx.beginPath(); ctx.moveTo(0, gy); ctx.lineTo(canvas.width, gy); ctx.stroke();
            }

            // Karpet jalan utama mall
            ctx.fillStyle = '#E1F5FE';
            ctx.fillRect(30, 185, 800, 170);
            ctx.strokeStyle = '#81D4FA';
            ctx.lineWidth = 3;
            ctx.strokeRect(30, 185, 800, 170);

            // 2. Dekorasi Tanaman Sudut
            const plants = [[35, 35], [825, 35], [35, 505], [825, 505], [295, 95], [565, 95], [295, 445], [565, 445]];
            plants.forEach(([px, py]) => {
                ctx.fillStyle = '#8D6E63';
                ctx.beginPath(); ctx.arc(px, py, 12, 0, Math.PI * 2); ctx.fill();
                ctx.fillStyle = '#66BB6A';
                ctx.beginPath(); ctx.arc(px - 4, py - 3, 9, 0, Math.PI * 2); ctx.fill();
                ctx.fillStyle = '#81C784';
                ctx.beginPath(); ctx.arc(px + 4, py - 2, 8, 0, Math.PI * 2); ctx.fill();
            });

            // 3. Air Mancur Tengah & Bangku Mall
            mallObstacles.forEach(obs => {
                if (obs.type === 'fountain') {
                    ctx.fillStyle = '#B3E5FC';
                    ctx.strokeStyle = '#0288D1';
                    ctx.lineWidth = 4;
                    ctx.beginPath();
                    ctx.roundRect(obs.x, obs.y, obs.w, obs.h, 24);
                    ctx.fill();
                    ctx.stroke();
                    ctx.fillStyle = '#0288D1';
                    ctx.font = 'bold 13px sans-serif';
                    ctx.textAlign = 'center';
                    ctx.fillText('⛲ AIR MANCUR', obs.x + obs.w / 2, obs.y + 33);
                } else {
                    ctx.fillStyle = '#D7CCC8';
                    ctx.strokeStyle = '#6D4C41';
                    ctx.lineWidth = 2;
                    ctx.beginPath();
                    ctx.roundRect(obs.x, obs.y, obs.w, obs.h, 8);
                    ctx.fill();
                    ctx.stroke();
                }
            });

            // 4. Gambar 6 Toko Berwarna-warni
            mallShops.forEach(s => {
                const isDone = GameState.mallCompletedShops.has(s.id);

                // Bayangan bangunan
                ctx.fillStyle = 'rgba(0,0,0,0.08)';
                ctx.fillRect(s.x + 6, s.y + 6, s.w, s.h);

                // Badan Toko
                ctx.fillStyle = s.color;
                ctx.strokeStyle = s.roof;
                ctx.lineWidth = 4;
                ctx.beginPath();
                ctx.roundRect(s.x, s.y, s.w, s.h, 14);
                ctx.fill();
                ctx.stroke();

                // Atap Bergaris
                ctx.fillStyle = s.roof;
                ctx.beginPath();
                ctx.roundRect(s.x - 4, s.y - 4, s.w + 8, 34, 12);
                ctx.fill();

                // Papan Nama Toko
                ctx.fillStyle = '#FFFFFF';
                ctx.font = 'bold 14px sans-serif';
                ctx.textAlign = 'center';
                ctx.fillText(`${s.icon} ${s.name}`, s.x + s.w / 2, s.y + 18);

                // Jendela & Status Selesai
                ctx.fillStyle = 'rgba(255,255,255,0.75)';
                ctx.fillRect(s.x + 18, s.y + 44, 65, 42);
                ctx.fillRect(s.x + s.w - 83, s.y + 44, 65, 42);

                ctx.font = '26px sans-serif';
                ctx.fillText(s.icon, s.x + 50, s.y + 74);
                ctx.fillText(isDone ? '✅' : '❓', s.x + s.w - 50, s.y + 74);

                // Zona Pintu Interaksi (Lingkaran Berdenyut di Lantai)
                ctx.fillStyle = isDone ? 'rgba(76, 175, 80, 0.25)' : 'rgba(255, 64, 129, 0.25)';
                ctx.beginPath();
                ctx.arc(s.doorX, s.doorY, 22, 0, Math.PI * 2);
                ctx.fill();
                ctx.strokeStyle = isDone ? '#2E7D32' : '#F50057';
                ctx.lineWidth = 2;
                ctx.stroke();
            });

            // 5. Gambar Karakter Pemain (Detektif Cilik Top-Down Lucu)
            const bob = playerMall.moving ? Math.sin(playerMall.walkFrame) * 3 : 0;
            const px = playerMall.x;
            const py = playerMall.y + bob;

            // Bayangan kaki
            ctx.fillStyle = 'rgba(0,0,0,0.18)';
            ctx.beginPath();
            ctx.ellipse(playerMall.x, playerMall.y + 16, 14, 6, 0, 0, Math.PI * 2);
            ctx.fill();

            // Badan (Seragam Merah Putih)
            ctx.fillStyle = '#FF5252';
            ctx.beginPath();
            ctx.arc(px, py + 6, 14, 0, Math.PI * 2);
            ctx.fill();

            // Kepala
            ctx.fillStyle = '#FFCCBC';
            ctx.beginPath();
            ctx.arc(px, py - 6, 13, 0, Math.PI * 2);
            ctx.fill();

            // Topi Detektif Cokelat
            ctx.fillStyle = '#8D6E63';
            ctx.beginPath();
            ctx.ellipse(px, py - 12, 16, 6, 0, 0, Math.PI * 2);
            ctx.fill();
            ctx.beginPath();
            ctx.arc(px, py - 14, 10, Math.PI, 0);
            ctx.fill();

            // Mata
            ctx.fillStyle = '#212121';
            ctx.beginPath();
            ctx.arc(px - 4, py - 5, 2, 0, Math.PI * 2);
            ctx.arc(px + 4, py - 5, 2, 0, Math.PI * 2);
            ctx.fill();
        }

        function mallGameLoop() {
            updateMallSimulation();
            drawMallWorld();
            requestAnimationFrame(mallGameLoop);
        }

