                questions: [
                    { q: "Apa fonem awal kata KUDA?", opts: ["A. /k/", "B. /u/", "C. /d/"], ans: 0, exp: "Tepat! Fonem awal kata KUDA adalah /k/." },
                    { q: "Apa saja fonem vokal pada kata KUDA?", opts: ["A. /u/ dan /a/", "B. /k/ dan /d/", "C. /i/ dan /o/"], ans: 0, exp: "Luar biasa! Fonem vokal pada KUDA adalah /u/ dan /a/." }
                ]
            }
        ];

        let puzzleOrder = [];
        let selectedPiecePos = null;
        let puzzleSolvedState = false;
        let activePuzzleQIdx = 0;

        function populatePuzzleSelector() {
            const sel = document.getElementById('puzzleWordSelect');
            sel.innerHTML = '';
            puzzleWordsData.forEach((item, idx) => {
                const opt = document.createElement('option');
                opt.value = idx;
                opt.textContent = `${item.label} ${GameState.puzzleCompletedWords.has(item.word) ? '✅' : ''}`;
                sel.appendChild(opt);
            });
        }

        function getPuzzleGridDimensions() {
            const diff = document.getElementById('puzzleDifficultySelect').value;
            if (diff === '2') return { cols: 2, rows: 2 };
            if (diff === '3-2') return { cols: 3, rows: 2 };
            return { cols: 3, rows: 3 };
        }

        function initPuzzleGame() {
            const wordIdx = parseInt(document.getElementById('puzzleWordSelect').value || '0', 10);
            const wordObj = puzzleWordsData[wordIdx];
            document.getElementById('puzzleCurrentWordLabel').textContent = wordObj.word;

            const { cols, rows } = getPuzzleGridDimensions();
            const total = cols * rows;
            puzzleOrder = Array.from({ length: total }, (_, i) => i);

            // Acak potongan gambar (pastikan tidak langsung tersusun rapi)
            do {
                for (let i = puzzleOrder.length - 1; i > 0; i--) {
                    const j = Math.floor(Math.random() * (i + 1));
                    [puzzleOrder[i], puzzleOrder[j]] = [puzzleOrder[j], puzzleOrder[i]];
                }
            } while (puzzleOrder.every((val, idx) => val === idx));

            selectedPiecePos = null;
            puzzleSolvedState = false;
            document.getElementById('puzzleChallengeBox').style.display = 'none';
            renderPuzzleBoard();
        }

        function renderPuzzleBoard() {
            const wordIdx = parseInt(document.getElementById('puzzleWordSelect').value || '0', 10);
            const wordObj = puzzleWordsData[wordIdx];
            const { cols, rows } = getPuzzleGridDimensions();
            const board = document.getElementById('puzzleBoard');

            board.style.gridTemplateColumns = `repeat(${cols}, 1fr)`;
            board.style.gridTemplateRows = `repeat(${rows}, 1fr)`;
            board.innerHTML = '';

            puzzleOrder.forEach((pieceIdx, boardPos) => {
                const piece = document.createElement('div');
                piece.className = 'puzzle-piece' +
                    (selectedPiecePos === boardPos ? ' selected' : '') +
                    (puzzleSolvedState ? ' solved-piece' : '');

                const origCol = pieceIdx % cols;
                const origRow = Math.floor(pieceIdx / cols);

                // Render potongan ilustrasi SVG sesuai koordinat baris & kolom
                const inner = document.createElement('div');
                inner.style.position = 'absolute';
                inner.style.width = `${cols * 100}%`;
                inner.style.height = `${rows * 100}%`;
                inner.style.left = `-${origCol * 100}%`;
                inner.style.top = `-${origRow * 100}%`;
                inner.style.pointerEvents = 'none';
                inner.innerHTML = wordObj.svg;

                piece.appendChild(inner);
                piece.onclick = () => handlePuzzlePieceClick(boardPos);
                board.appendChild(piece);
            });
        }

        function handlePuzzlePieceClick(boardPos) {
            if (puzzleSolvedState) return;
            AudioEngine.playClick();

            if (selectedPiecePos === null) {
                selectedPiecePos = boardPos;
                renderPuzzleBoard();
            } else if (selectedPiecePos === boardPos) {
                selectedPiecePos = null;
                renderPuzzleBoard();
            } else {
                // Tukar posisi dua potongan
                [puzzleOrder[selectedPiecePos], puzzleOrder[boardPos]] = [puzzleOrder[boardPos], puzzleOrder[selectedPiecePos]];
                selectedPiecePos = null;
                renderPuzzleBoard();
                checkPuzzleCompleted();
            }
        }

        function checkPuzzleCompleted() {
            const isComplete = puzzleOrder.every((val, idx) => val === idx);
            if (isComplete) {
                puzzleSolvedState = true;
                renderPuzzleBoard();
                AudioEngine.playCorrectFeedback();
                triggerStarBurst();

                activePuzzleQIdx = 0;
                document.getElementById('puzzleChallengeBox').style.display = 'block';
                renderPuzzleQuestion();
            }
        }

        function renderPuzzleQuestion() {
            const wordIdx = parseInt(document.getElementById('puzzleWordSelect').value || '0', 10);
            const wordObj = puzzleWordsData[wordIdx];
            const qObj = wordObj.questions[activePuzzleQIdx];

            document.getElementById('puzzleChallengeProgress').textContent =
                `Tantangan Kata ${wordObj.word} (${activePuzzleQIdx + 1} dari ${wordObj.questions.length})`;
            document.getElementById('puzzleQuestionText').textContent = qObj.q;

            const fb = document.getElementById('puzzleFeedback');
            fb.className = 'feedback-banner';
            fb.style.display = 'none';

            const grid = document.getElementById('puzzleOptionsGrid');
            grid.innerHTML = '';
            qObj.opts.forEach((opt, idx) => {
                const btn = document.createElement('button');
                btn.className = 'option-btn';
                btn.textContent = opt;
                btn.onclick = () => {
                    if (idx === qObj.ans) {
                        btn.classList.add('correct');
                        grid.querySelectorAll('button').forEach(b => b.disabled = true);
                        fb.className = 'feedback-banner success';
                        fb.innerHTML = `🌟 <strong>HOREEEEE! KAMU HEBAT!</strong><br>${qObj.exp}`;
                        fb.style.display = 'block';
                        AudioEngine.playCorrectFeedback();
                        triggerStarBurst();

                        setTimeout(() => {
                            if (activePuzzleQIdx < wordObj.questions.length - 1) {
                                activePuzzleQIdx++;
                                renderPuzzleQuestion();
                            } else {
                                const isNew = !GameState.puzzleCompletedWords.has(wordObj.word);
                                GameState.puzzleCompletedWords.add(wordObj.word);
                                if (isNew) addRewards(3, 15);
                                populatePuzzleSelector();
                                document.getElementById('puzzleWordSelect').value = wordIdx;
                                AudioEngine.playApplauseAndWin();
                                launchConfetti(45);
                                fb.innerHTML = `🏆 <strong>SELAMAT!</strong> Puzzle & Tantangan Kata <strong>${wordObj.word}</strong> Selesai! Pilih kata berikutnya di atas!`;
                            }
                        }, 1300);
                    } else {
                        btn.classList.add('wrong');
                        setTimeout(() => btn.classList.remove('wrong'), 450);
                        fb.className = 'feedback-banner retry';
                        fb.innerHTML = `💪 <strong>COBAAA LAGI! KAMU PASTI BISA!</strong>`;
                        fb.style.display = 'block';
                        AudioEngine.playWrongFeedback();
                    }
                };
                grid.appendChild(btn);
            });
        }

        function resetAllProgress() {
            AudioEngine.playClick();
            GameState.stars = 0;
            GameState.coins = 0;
            GameState.detectiveSolved.clear();
            GameState.mallCompletedShops.clear();
            GameState.puzzleCompletedWords.clear();
            currentDetIdx = 0;
            renderDetectiveQuestion();
            renderMallShopChips();
            populatePuzzleSelector();
            initPuzzleGame();
            updateAllHUD();
        }

        /* ==========================================================================
           G. INISIALISASI SAAT HALAMAN SELESAI DIMUAT
           ========================================================================== */
        window.onload = function () {
            renderDetectiveQuestion();
            setupMallControls();
            renderMallShopChips();
            mallGameLoop();
            populatePuzzleSelector();
            initPuzzleGame();
            updateAllHUD();
        };
    </script>
</body>
</html>
